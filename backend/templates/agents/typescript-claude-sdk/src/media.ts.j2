import Anthropic from '@anthropic-ai/sdk';
{% if webhooks.chatwoot.media_processing.get("video_analysis", true) %}
import { GoogleGenerativeAI } from '@google/generative-ai';
{% endif %}
import type { ChatwootAttachment } from './types.js';

type ImageMediaType = 'image/jpeg' | 'image/png' | 'image/gif' | 'image/webp';

// =============================================================================
// Download Media
// =============================================================================

async function downloadMedia(
  url: string,
  retries = 3,
): Promise<{ data: Buffer; contentType: string } | null> {
  for (let attempt = 1; attempt <= retries; attempt++) {
    try {
      const response = await fetch(url);
      if (!response.ok) {
        if (response.status === 404 && attempt < retries) {
          await new Promise(r => setTimeout(r, attempt * 2000));
          continue;
        }
        console.error(`[Media] Download failed: ${response.status}`);
        return null;
      }
      const contentType = response.headers.get('content-type') || 'application/octet-stream';
      const arrayBuffer = await response.arrayBuffer();
      return { data: Buffer.from(arrayBuffer), contentType };
    } catch (error) {
      if (attempt < retries) {
        await new Promise(r => setTimeout(r, attempt * 2000));
        continue;
      }
      console.error('[Media] Download error:', error);
      return null;
    }
  }
  return null;
}

// =============================================================================
// Audio Transcription (OpenAI Whisper)
// =============================================================================

{% if webhooks.chatwoot.media_processing.get("audio_transcription", true) %}
async function transcribeAudio(audioBuffer: Buffer, contentType: string): Promise<string> {
  const apiKey = process.env.OPENAI_API_KEY;
  if (!apiKey) {
    return '[Audio message received but transcription is not configured]';
  }

  try {
    const ext = contentType.includes('ogg') ? 'ogg' : contentType.includes('mp4') ? 'mp4' : 'wav';
    const blob = new Blob([audioBuffer], { type: contentType });
    const file = new File([blob], `audio.${ext}`, { type: contentType });

    const formData = new FormData();
    formData.append('file', file);
    formData.append('model', 'whisper-1');
    formData.append('language', 'es');

    const response = await fetch('https://api.openai.com/v1/audio/transcriptions', {
      method: 'POST',
      headers: { Authorization: `Bearer ${apiKey}` },
      body: formData,
    });

    if (!response.ok) {
      console.error(`[Media] Whisper error: ${response.status}`);
      return '[Audio message could not be transcribed]';
    }

    const result = (await response.json()) as { text: string };
    console.log(`[Media] Audio transcribed: "${result.text.substring(0, 80)}..."`);
    return `[Audio message transcription]: "${result.text}"`;
  } catch (error) {
    console.error('[Media] Transcription error:', error);
    return '[Audio message could not be transcribed]';
  }
}
{% endif %}

// =============================================================================
// Image Analysis (Claude Vision)
// =============================================================================

{% if webhooks.chatwoot.media_processing.get("image_analysis", true) %}
async function analyzeImage(imageBuffer: Buffer, contentType: string): Promise<string> {
  const apiKey = process.env.ANTHROPIC_API_KEY;
  if (!apiKey) {
    return '[Image received but analysis is not configured]';
  }

  try {
    const client = new Anthropic({ apiKey });
    const base64 = imageBuffer.toString('base64');
    const mediaType = (contentType || 'image/jpeg') as ImageMediaType;

    const response = await client.messages.create({
      model: 'claude-sonnet-4-5-20250929',
      max_tokens: 1024,
      messages: [
        {
          role: 'user',
          content: [
            {
              type: 'image',
              source: { type: 'base64', media_type: mediaType, data: base64 },
            },
            {
              type: 'text',
              text: 'Describe what you see in this image. If it contains text, numbers, or data, extract and include that information. Be concise but thorough.',
            },
          ],
        },
      ],
    });

    const analysis = response.content
      .filter(b => b.type === 'text')
      .map(b => (b as { type: 'text'; text: string }).text)
      .join('\n');

    console.log(`[Media] Image analyzed: ${analysis.substring(0, 80)}...`);
    return `[Image analysis]: ${analysis}`;
  } catch (error) {
    console.error('[Media] Image analysis error:', error);
    return '[Image received but could not be analyzed]';
  }
}
{% endif %}

// =============================================================================
// Video Analysis (Gemini)
// =============================================================================

{% if webhooks.chatwoot.media_processing.get("video_analysis", true) %}
async function analyzeVideo(videoBuffer: Buffer, contentType: string): Promise<string> {
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) {
    return '[Video received but analysis is not configured]';
  }

  try {
    const genAI = new GoogleGenerativeAI(apiKey);
    const model = genAI.getGenerativeModel({ model: 'gemini-2.0-flash' });
    const base64 = videoBuffer.toString('base64');

    const result = await model.generateContent([
      {
        inlineData: {
          mimeType: contentType || 'video/mp4',
          data: base64,
        },
      },
      'Describe what you see in this video. If it shows any issues, damage, or notable content, describe it in detail. Be concise.',
    ]);

    const analysis = result.response.text();
    console.log(`[Media] Video analyzed: ${analysis.substring(0, 80)}...`);
    return `[Video analysis]: ${analysis}`;
  } catch (error) {
    console.error('[Media] Video analysis error:', error);
    return '[Video received but could not be analyzed]';
  }
}
{% endif %}

// =============================================================================
// Process All Media Attachments
// =============================================================================

export async function processMediaAttachments(
  attachments: ChatwootAttachment[],
): Promise<string> {
  const results: string[] = [];

  for (const attachment of attachments) {
    if (!attachment.data_url) continue;

    const media = await downloadMedia(attachment.data_url);
    if (!media) {
      results.push(`[${attachment.file_type} could not be downloaded]`);
      continue;
    }

    switch (attachment.file_type) {
{% if webhooks.chatwoot.media_processing.get("audio_transcription", true) %}
      case 'audio':
        results.push(await transcribeAudio(media.data, media.contentType));
        break;
{% endif %}
{% if webhooks.chatwoot.media_processing.get("image_analysis", true) %}
      case 'image':
        results.push(await analyzeImage(media.data, media.contentType));
        break;
{% endif %}
{% if webhooks.chatwoot.media_processing.get("video_analysis", true) %}
      case 'video':
        results.push(await analyzeVideo(media.data, media.contentType));
        break;
{% endif %}
      default:
        break;
    }
  }

  return results.join('\n');
}
{% endif %}
