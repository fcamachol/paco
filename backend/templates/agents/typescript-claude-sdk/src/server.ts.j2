/**
 * {{ agent.display_name }} — Express Server
 * Generated by PACO — /health, /metrics, /api/chat, /chatwoot
 */

import express from 'express';
import { config } from './config/index.js';
import { configManager } from './config/config-manager.js';
import { processMessage } from './agent.js';
import { registry, messagesTotal, errorRate } from './utils/metrics.js';
import type { ChatRequest } from './types.js';
{% if webhooks.get("chatwoot") %}
import type { ChatwootWebhookPayload } from './types.js';
import {
  sendToChatwoot,
  shouldProcessWebhook,
  extractMessageContent,
  processAttachments,
  buildChatwootContext,
  getChatwootStatus,
} from './chatwoot.js';
{% endif %}

const app = express();
app.use(express.json());

// =============================================================================
// Health Check
// =============================================================================

app.get('/health', async (_req, res) => {
  try {
    const metrics = await registry.getMetricsAsJSON();
    const errorMetric = metrics.find(m => m.name === 'agent_error_rate');
    const currentErrorRate = errorMetric ? Number((errorMetric as { values?: Array<{ value: number }> }).values?.[0]?.value || 0) : 0;

    res.json({
      status: currentErrorRate > config.healthErrorThreshold ? 'degraded' : 'healthy',
      agent: config.agentName,
      version: '{{ agent.version }}',
      uptime: process.uptime(),
      errorRate: currentErrorRate,
    });
  } catch {
    res.json({
      status: 'healthy',
      agent: config.agentName,
      version: '{{ agent.version }}',
      uptime: process.uptime(),
    });
  }
});

// =============================================================================
// Prometheus Metrics
// =============================================================================

{% if metrics.get("prometheus", True) %}
app.get('/metrics', async (_req, res) => {
  try {
    res.set('Content-Type', registry.contentType);
    res.end(await registry.metrics());
  } catch (err) {
    res.status(500).end(String(err));
  }
});
{% endif %}

// =============================================================================
// Chat API
// =============================================================================

app.post('/api/chat', async (req, res) => {
  try {
    const { message, conversationId, contactId, metadata } = req.body as ChatRequest & { metadata?: Record<string, unknown> };

    if (!message || !conversationId) {
      res.status(400).json({ error: 'message and conversationId are required' });
      return;
    }

    const result = await processMessage({
      message,
      conversationId,
      contactId,
      metadata,
    });

    res.json(result);
  } catch (error) {
    const errMsg = error instanceof Error ? error.message : String(error);
    console.error('[Server] Chat error:', errMsg);
    res.status(500).json({ error: 'Internal server error' });
  }
});

{% if webhooks.get("chatwoot") %}
// =============================================================================
// Chatwoot Webhook
// =============================================================================

app.post('/chatwoot', async (req, res) => {
  const payload = req.body as ChatwootWebhookPayload;

  // Return 200 immediately to avoid Chatwoot timeout
  res.status(200).json({ received: true });

  // Validate webhook
  const validation = shouldProcessWebhook(payload);
  if (!validation.shouldProcess) {
    console.log(`[Chatwoot] Skipping: ${validation.reason}`);
    return;
  }

  console.log(`[Chatwoot] Message from ${payload.sender?.name} in conversation ${payload.conversation?.id}`);

  try {
    const context = buildChatwootContext(payload);
    const { text, attachments, hasMedia } = extractMessageContent(payload);

    let messageText = text;
    if (hasMedia) {
      const attachmentText = await processAttachments(attachments);
      messageText = messageText
        ? `${messageText}\n\n${attachmentText}`
        : attachmentText;
    }

    if (!messageText.trim()) {
      console.log('[Chatwoot] Empty message, skipping');
      return;
    }

    const result = await processMessage({
      message: messageText,
      conversationId: context.conversationId,
      contactId: String(context.chatwootContactId),
      metadata: {
        name: context.senderName,
        phone: context.senderPhone,
        email: context.senderEmail,
        chatwootAccountId: context.accountId,
        chatwootConversationId: context.chatwootConversationId,
        customAttributes: context.customAttributes,
      },
    });

    const responseText = result.response;
    const messages = responseText.split(/\n{3,}/).filter((m: string) => m.trim());

    for (let i = 0; i < messages.length; i++) {
      if (i > 0) {
        await new Promise(resolve => setTimeout(resolve, {{ webhooks.chatwoot.get("multi_message_delay_ms", 1500) }}));
      }
      const sendResult = await sendToChatwoot(
        context.accountId,
        context.chatwootConversationId,
        messages[i].trim(),
      );
      if (!sendResult.success) {
        console.error(`[Chatwoot] Failed to send message ${i + 1}: ${sendResult.error}`);
      }
    }
  } catch (error) {
    console.error('[Chatwoot] Processing error:', error);
    try {
      const context = buildChatwootContext(payload);
      await sendToChatwoot(
        context.accountId,
        context.chatwootConversationId,
        'Sorry, I had a problem processing your message. Please try again in a moment.',
      );
    } catch (sendError) {
      console.error('[Chatwoot] Failed to send error message:', sendError);
    }
  }
});
{% endif %}

// =============================================================================
// Admin: Config Reload (called by PACO backend on config changes)
// =============================================================================

app.post('/admin/reload', async (_req, res) => {
  try {
    const updated = await configManager.reload();
    const currentConfig = configManager.getConfig();
    res.json({
      status: updated ? 'reloaded' : 'unchanged',
      version: configManager.getVersion(),
      model: currentConfig.model,
      toolCount: currentConfig.tools.length,
      mcpServerCount: Object.keys(currentConfig.mcpServers).length,
      skillCount: currentConfig.skills.length,
    });
  } catch (error) {
    const errMsg = error instanceof Error ? error.message : String(error);
    console.error('[Admin] Reload error:', errMsg);
    res.status(500).json({ error: errMsg });
  }
});

app.get('/admin/config', (_req, res) => {
  const currentConfig = configManager.getConfig();
  res.json({
    version: configManager.getVersion(),
    lastFetchAt: configManager.getLastFetchAt(),
    connectedToPaco: configManager.isConnectedToPaco(),
    model: currentConfig.model,
    systemPromptLength: currentConfig.systemPrompt.length,
    mcpServers: Object.keys(currentConfig.mcpServers),
    tools: currentConfig.tools.map(t => t.name),
    skills: currentConfig.skills.map(s => ({ code: s.code, enabled: s.is_enabled })),
  });
});

// =============================================================================
// Start Server
// =============================================================================

// Load dynamic config from PACO API on startup (best-effort)
configManager.reload().then(updated => {
  if (updated) {
    console.log('[ConfigManager] Loaded live config from PACO API');
  } else {
    console.log('[ConfigManager] Using baked-in defaults');
  }
});

app.listen(config.port, () => {
  console.log(`{{ agent.display_name }} running on port ${config.port}`);
  console.log(`  Health: http://localhost:${config.port}/health`);
{% if metrics.get("prometheus", True) %}
  console.log(`  Metrics: http://localhost:${config.port}/metrics`);
{% endif %}
  console.log(`  Chat: http://localhost:${config.port}/api/chat`);
{% if webhooks.get("chatwoot") %}
  console.log(`  Chatwoot: http://localhost:${config.port}/chatwoot`);
{% endif %}
  console.log(`  Admin: http://localhost:${config.port}/admin/config`);
});
