import logging
import time
from typing import Any

import httpx

from config import settings

logger = logging.getLogger(__name__)

# Track processed message IDs to avoid duplicates
_processed_messages: dict[int, float] = {}
_MESSAGE_CACHE_TTL = 60.0  # seconds


def _cleanup_cache():
    """Remove expired entries from dedup cache."""
    now = time.time()
    expired = [k for k, v in _processed_messages.items() if now - v > _MESSAGE_CACHE_TTL]
    for k in expired:
        del _processed_messages[k]


async def send_to_chatwoot(
    account_id: int,
    conversation_id: int,
    message: str,
) -> dict[str, Any]:
    """Send a message back to Chatwoot."""
    if not settings.chatwoot_url or not settings.chatwoot_token:
        return {"success": False, "error": "Chatwoot not configured"}

    url = f"{settings.chatwoot_url}/api/v1/accounts/{account_id}/conversations/{conversation_id}/messages"

    try:
        async with httpx.AsyncClient() as client:
            response = await client.post(
                url,
                headers={"api_access_token": settings.chatwoot_token},
                json={
                    "content": message,
                    "message_type": "outgoing",
                    "private": False,
                },
            )
            response.raise_for_status()
            data = response.json()
            return {"success": True, "message_id": data.get("id")}
    except Exception as e:
        logger.error(f"[Chatwoot] Send error: {e}")
        return {"success": False, "error": str(e)}


def should_process_webhook(payload: dict[str, Any]) -> tuple[bool, str]:
    """Validate webhook payload. Returns (should_process, reason)."""
    if payload.get("event") != "message_created":
        return False, f"Event type: {payload.get('event')}"

    if payload.get("message_type") != "incoming":
        return False, f"Message type: {payload.get('message_type')}"

    sender_type = (payload.get("sender") or {}).get("type")
    if sender_type in ("user", "agent_bot"):
        return False, f"Sender type: {sender_type}"

{% if webhooks.chatwoot.get("filter_open_conversations", true) %}
    conv_status = (payload.get("conversation") or {}).get("status")
    if conv_status == "open":
        return False, f"Conversation status: {conv_status} (human handling)"
{% endif %}

    msg_id = payload.get("id")
    if msg_id and msg_id in _processed_messages:
        return False, "Duplicate message"

    if msg_id:
        _processed_messages[msg_id] = time.time()
        _cleanup_cache()

    return True, "ok"


def extract_message_content(payload: dict[str, Any]) -> dict[str, Any]:
    """Extract text and attachments from payload."""
    return {
        "text": payload.get("content") or "",
        "attachments": payload.get("attachments") or [],
        "has_media": bool(payload.get("attachments")),
    }


def build_chatwoot_context(payload: dict[str, Any]) -> dict[str, Any]:
    """Build conversation context from payload."""
    conversation = payload.get("conversation") or {}
    sender = payload.get("sender") or {}
    account = payload.get("account") or {}
    inbox = payload.get("inbox") or {}

    return {
        "conversation_id": f"chatwoot-{conversation.get('id')}",
        "account_id": account.get("id", 1),
        "chatwoot_conversation_id": conversation.get("id", 0),
        "chatwoot_contact_id": sender.get("id", 0),
        "sender_name": sender.get("name", "User"),
        "sender_phone": sender.get("phone_number"),
        "sender_email": sender.get("email"),
        "custom_attributes": sender.get("custom_attributes"),
        "inbox_name": inbox.get("name", "Unknown"),
        "channel": conversation.get("channel", "Unknown"),
    }


async def update_conversation_status(
    account_id: int,
    conversation_id: int,
    status: str,
) -> dict[str, Any]:
    """Update Chatwoot conversation status for human handoff."""
    if not settings.chatwoot_url or not settings.chatwoot_token:
        return {"success": False, "error": "Chatwoot not configured"}

    url = f"{settings.chatwoot_url}/api/v1/accounts/{account_id}/conversations/{conversation_id}"

    try:
        async with httpx.AsyncClient() as client:
            response = await client.patch(
                url,
                headers={"api_access_token": settings.chatwoot_token},
                json={"status": status},
            )
            response.raise_for_status()
            return {"success": True}
    except Exception as e:
        logger.error(f"[Chatwoot] Status update error: {e}")
        return {"success": False, "error": str(e)}


def get_chatwoot_status() -> dict[str, Any]:
    """Health check for Chatwoot integration."""
    return {
        "configured": bool(settings.chatwoot_url and settings.chatwoot_token),
        "base_url": settings.chatwoot_url or "not set",
        "has_token": bool(settings.chatwoot_token),
    }
