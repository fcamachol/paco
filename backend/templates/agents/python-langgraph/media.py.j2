import base64
import logging
import os
from typing import Any

import httpx

logger = logging.getLogger(__name__)


async def download_media(url: str, retries: int = 3) -> tuple[bytes, str] | None:
    """Download media from URL with retry."""
    import asyncio

    for attempt in range(1, retries + 1):
        try:
            async with httpx.AsyncClient() as client:
                response = await client.get(url, follow_redirects=True, timeout=30.0)
                if response.status_code == 404 and attempt < retries:
                    await asyncio.sleep(attempt * 2)
                    continue
                response.raise_for_status()
                content_type = response.headers.get("content-type", "application/octet-stream")
                return response.content, content_type
        except Exception as e:
            if attempt < retries:
                await asyncio.sleep(attempt * 2)
                continue
            logger.error(f"[Media] Download error: {e}")
            return None
    return None


{% if webhooks.chatwoot.media_processing.get("audio_transcription", true) %}
async def transcribe_audio(audio_data: bytes, content_type: str) -> str:
    """Transcribe audio using OpenAI Whisper API."""
    api_key = os.environ.get("OPENAI_API_KEY")
    if not api_key:
        return "[Audio message received but transcription is not configured]"

    try:
        ext = "ogg" if "ogg" in content_type else "mp4" if "mp4" in content_type else "wav"
        async with httpx.AsyncClient() as client:
            response = await client.post(
                "https://api.openai.com/v1/audio/transcriptions",
                headers={"Authorization": f"Bearer {api_key}"},
                files={"file": (f"audio.{ext}", audio_data, content_type)},
                data={"model": "whisper-1", "language": "es"},
                timeout=60.0,
            )
            response.raise_for_status()
            result = response.json()
            text = result.get("text", "")
            return f'[Audio message transcription]: "{text}"'
    except Exception as e:
        logger.error(f"[Media] Transcription error: {e}")
        return "[Audio message could not be transcribed]"
{% endif %}


{% if webhooks.chatwoot.media_processing.get("image_analysis", true) %}
async def analyze_image(image_data: bytes, content_type: str) -> str:
    """Analyze image using Claude Vision."""
    api_key = os.environ.get("ANTHROPIC_API_KEY")
    if not api_key:
        return "[Image received but analysis is not configured]"

    try:
        import anthropic

        client = anthropic.Anthropic(api_key=api_key)
        b64 = base64.standard_b64encode(image_data).decode()
        media_type = content_type or "image/jpeg"

        response = client.messages.create(
            model="claude-sonnet-4-5-20250929",
            max_tokens=1024,
            messages=[
                {
                    "role": "user",
                    "content": [
                        {
                            "type": "image",
                            "source": {"type": "base64", "media_type": media_type, "data": b64},
                        },
                        {
                            "type": "text",
                            "text": "Describe what you see in this image. If it contains text, numbers, or data, extract and include that information. Be concise but thorough.",
                        },
                    ],
                }
            ],
        )

        analysis = "\n".join(b.text for b in response.content if b.type == "text")
        return f"[Image analysis]: {analysis}"
    except Exception as e:
        logger.error(f"[Media] Image analysis error: {e}")
        return "[Image received but could not be analyzed]"
{% endif %}


{% if webhooks.chatwoot.media_processing.get("video_analysis", true) %}
async def analyze_video(video_data: bytes, content_type: str) -> str:
    """Analyze video using Gemini."""
    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        return "[Video received but analysis is not configured]"

    try:
        import google.generativeai as genai

        genai.configure(api_key=api_key)
        model = genai.GenerativeModel("gemini-2.0-flash")
        b64 = base64.standard_b64encode(video_data).decode()

        response = model.generate_content(
            [
                {"inline_data": {"mime_type": content_type or "video/mp4", "data": b64}},
                "Describe what you see in this video. If it shows any issues or notable content, describe it in detail. Be concise.",
            ]
        )
        return f"[Video analysis]: {response.text}"
    except Exception as e:
        logger.error(f"[Media] Video analysis error: {e}")
        return "[Video received but could not be analyzed]"
{% endif %}


async def process_media_attachments(attachments: list[dict[str, Any]]) -> str:
    """Process all media attachments and return combined text."""
    results: list[str] = []

    for attachment in attachments:
        data_url = attachment.get("data_url")
        if not data_url:
            continue

        media = await download_media(data_url)
        if not media:
            results.append(f"[{attachment.get('file_type', 'media')} could not be downloaded]")
            continue

        data, ct = media
        file_type = attachment.get("file_type", "")

{% if webhooks.chatwoot.media_processing.get("audio_transcription", true) %}
        if file_type == "audio":
            results.append(await transcribe_audio(data, ct))
            continue
{% endif %}
{% if webhooks.chatwoot.media_processing.get("image_analysis", true) %}
        if file_type == "image":
            results.append(await analyze_image(data, ct))
            continue
{% endif %}
{% if webhooks.chatwoot.media_processing.get("video_analysis", true) %}
        if file_type == "video":
            results.append(await analyze_video(data, ct))
            continue
{% endif %}

    return "\n".join(results)
{% endif %}
