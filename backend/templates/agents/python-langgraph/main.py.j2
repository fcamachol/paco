async def _process_chatwoot_webhook(payload: dict[str, Any]):
    """Process Chatwoot webhook asynchronously."""
    import asyncio

    should_process, reason = should_process_webhook(payload)
    if not should_process:
        logger.info(f"[Chatwoot] Skipping: {reason}")
        return

    try:
        context = build_chatwoot_context(payload)
        content = extract_message_content(payload)

        message_text = content["text"]

{% if webhooks.chatwoot.get("media_processing") %}
        if content["has_media"]:
            attachment_text = await process_media_attachments(content["attachments"])
            message_text = f"{message_text}\n\n{attachment_text}" if message_text else attachment_text
{% endif %}

        if not message_text.strip():
            logger.info("[Chatwoot] Empty message, skipping")
            return

        result = await process_message(
            message=message_text,
            conversation_id=context["conversation_id"],
            contact_id=str(context["chatwoot_contact_id"]),
        )

        response_text = result.get("response", "")
        messages = [m.strip() for m in response_text.split("\n\n\n") if m.strip()]

        for i, msg in enumerate(messages):
            if i > 0:
                await asyncio.sleep({{ webhooks.chatwoot.get("multi_message_delay_ms", 1500) }} / 1000)
            send_result = await send_to_chatwoot(
                context["account_id"],
                context["chatwoot_conversation_id"],
                msg,
            )
            if not send_result["success"]:
                logger.error(f"[Chatwoot] Failed to send message {i + 1}: {send_result.get('error')}")

    except Exception as e:
        logger.error(f"[Chatwoot] Processing error: {e}")
        try:
            context = build_chatwoot_context(payload)
            await send_to_chatwoot(
                context["account_id"],
                context["chatwoot_conversation_id"],
                "Sorry, I had a problem processing your message. Please try again in a moment.",
            )
        except Exception as send_error:
            logger.error(f"[Chatwoot] Failed to send error message: {send_error}")


@app.post("/chatwoot")
async def chatwoot_webhook(request: Request, background_tasks: BackgroundTasks):
    """Handle Chatwoot webhook with fire-and-forget pattern."""
    payload = await request.json()
    background_tasks.add_task(_process_chatwoot_webhook, payload)
    return {"received": True}
